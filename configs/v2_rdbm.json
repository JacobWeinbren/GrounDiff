{
 "notes": "Residual Diffusion Bridge Model (Wang et al., CVPR 2026, github.com/MiliLab/RDBM, MIT) on the v2 data: a deterministic bridge from the DSM (gate surface) to the DTM, T=100, 10 sampling steps, x0 prediction through GrounDiff's gate, same task losses. Fine-tune from the v2 diffusion model: python -m groundiff.train configs/v2_rdbm.json --init-from runs/v2/best.pt",
 "data": {
  "root": "data/v2/scenes",
  "split_file": "data/v2/split.json",
  "cond_channels": [
   "dsm_max",
   "dsm_min",
   "dsm_last",
   "density",
   "z_std",
   "echoes"
  ],
  "gate_channel": "dsm_max",
  "norm_channels": [
   "dsm_max",
   "dsm_min"
  ],
  "norm_quantile": 0.001,
  "tile": 256,
  "alpha": 0.2,
  "loss_mask": "gt",
  "fill_empty": "nearest",
  "bridge_oversample": 0.15
 },
 "model": {
  "kind": "groundiff"
 },
 "diffusion": {
  "T": 10,
  "schedule": "cosine",
  "process": "rdbm",
  "bridge_T": 100,
  "bridge_steps": 10,
  "bridge_lambda": 0.0001,
  "bridge_residual_noise": false
 },
 "loss": {
  "lam_l1": 1.0,
  "lam_l2": 1.0,
  "lam_grad": 0.1,
  "lam_conf": 0.1
 },
 "optim": {
  "name": "adamw",
  "lr": 5e-05,
  "weight_decay": 0.01,
  "warmup_steps": 300,
  "total_steps": 8000
 },
 "train": {
  "out_dir": "runs/v2_rdbm",
  "batch_size": 4,
  "grad_accum": 4,
  "val_init": "dsm_noise",
  "val_every": 1000,
  "save_every": 500
 }
}