{
 "notes": "Single-step end-to-end fine-tune (Garcia et al., WACV 2025) of the v2 model: python -m groundiff.train configs/v2_1step.json --init-from runs/v2/best.pt Inputs as configs/v2.json (tile_range and ctx_* context).",
 "data": {
  "root": "data/v2/scenes",
  "split_file": "data/v2/split.json",
  "cond_channels": [
   "dsm_max",
   "dsm_min",
   "dsm_last",
   "density",
   "z_std",
   "echoes",
   "tile_range",
   "ctx_dsm_min",
   "ctx_dsm_max",
   "ctx_has_return"
  ],
  "gate_channel": "dsm_max",
  "norm_channels": [
   "dsm_max",
   "dsm_min"
  ],
  "norm_quantile": 0.001,
  "tile": 256,
  "alpha": 0.2,
  "loss_mask": "gt",
  "fill_empty": "nearest",
  "bridge_oversample": 0.15,
  "context_factor": 4
 },
 "model": {
  "kind": "groundiff"
 },
 "diffusion": {
  "T": 10,
  "schedule": "cosine",
  "one_step": true
 },
 "loss": {
  "lam_l1": 1.0,
  "lam_l2": 1.0,
  "lam_grad": 0.1,
  "lam_conf": 0.1
 },
 "optim": {
  "name": "adamw",
  "lr": 3e-05,
  "weight_decay": 0.01,
  "warmup_steps": 100,
  "total_steps": 3000
 },
 "train": {
  "out_dir": "runs/v2_1step",
  "batch_size": 4,
  "grad_accum": 4,
  "val_init": "dsm_noise",
  "val_every": 500,
  "save_every": 500
 }
}