{
 "notes": "SAR2SAR step A, part 1 (Dalsasso et al. 2021): GrounDiff (gated Palette UNet, DSM -> DTM) + tile_range, trained from scratch on each survey year's own EA DTM with GrounDiff's loss, on multi-year EA data.",
 "data": {
  "root": "data/mt/scenes",
  "split_file": "data/mt/split.json",
  "cond_channels": [
   "dsm_max",
   "dsm_min",
   "dsm_last",
   "density",
   "z_std",
   "echoes",
   "tile_range"
  ],
  "gate_channel": "dsm_max",
  "norm_channels": [
   "dsm_max",
   "dsm_min"
  ],
  "norm_quantile": 0.001,
  "tile": 256,
  "alpha": 0.2,
  "loss_mask": "gt",
  "fill_empty": "nearest",
  "cross_year": false,
  "eval_target": "own"
 },
 "model": {
  "kind": "groundiff"
 },
 "diffusion": {
  "T": 10,
  "schedule": "cosine"
 },
 "loss": {
  "lam_l1": 1.0,
  "lam_l2": 1.0,
  "lam_grad": 0.1,
  "lam_conf": 0.1
 },
 "optim": {
  "name": "adamw",
  "lr": 0.0001,
  "weight_decay": 0.01,
  "warmup_steps": 500,
  "total_steps": 20000
 },
 "train": {
  "out_dir": "runs/mt",
  "batch_size": 4,
  "grad_accum": 4,
  "val_init": "dsm_noise",
  "val_every": 1000,
  "save_every": 500
 }
}